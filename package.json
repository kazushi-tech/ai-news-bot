{
  "name": "ai-news-pipeline",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "summarize": "node scripts/summarize_article.mjs --pending",
    "daily": "node scripts/build_index_daily.mjs",
    "weekly": "node scripts/build_index_weekly.mjs",
    "ingest": "node scripts/ingest_rss.mjs",
    "home": "node scripts/build_home.mjs",
    "validate": "node scripts/validate_articles.mjs",
    "one": "npm run summarize && npm run daily -- --date $(date +%F) --link obsidian && npm run weekly -- --link obsidian && npm run home -- --link obsidian && npm run validate",
    "today": "npm run ingest && npm run one"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.1.0",
    "discord.js": "14.24.2",
    "dotenv": "16.6.1",
    "gray-matter": "^4.0.3",
    "p-limit": "7.2.0",
    "rss-parser": "3.13.0",
    "undici": "^6.19.8",
    "yaml": "2.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}