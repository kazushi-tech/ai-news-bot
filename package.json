{
  "name": "ai-news-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clip": "node scripts/clip_url.mjs --url",
    "sum": "node scripts/summarize_clip.mjs",
    "sum:latest": "sh -lc 'LATEST=$(ls -t src/clips/*.md | head -n1); [ -n \"$LATEST\" ] && node scripts/summarize_clip.mjs \"$LATEST\"'",
    "publish": "git add -A && git commit -m \"clip+sum (Gemini 2.5-flash)\" || true && git push",
    "one": "bash scripts/clip_sum_publish.sh"
  }
,
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "dayjs": "^1.11.19",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "jsdom": "^24.1.3",
    "turndown": "^7.2.2",
    "undici": "^6.22.0"
  }
}
