{
  "name": "ai-news-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "env:boot": "bash -lc 'set -a; [ -f .env ] && source .env; set +a; node -e \"console.log(process.env.GOOGLE_API_KEY ? \\\"OK\\\" : \\\"MISSING\\\")\"'",
    "summary": "node scripts/summarize_article.mjs",
    "validate": "node scripts/validate_articles.mjs",
    "daily": "bash -lc 'DATE=$(date +%F); node scripts/build_index_daily.mjs --date=\"${DATE}\" --link=publish'",
    "weekly": "bash -lc 'DATE=$(date +%F); node scripts/build_index_weekly.mjs --to=\"${DATE}\" --link=publish'",
    "weekly:range": "node scripts/build_index_weekly.mjs --from=2025-10-28 --to=2025-11-03 --link=publish",
    "backfill:dry": "node scripts/backfill_missing_summaries.mjs --max=10 --dry-run=true",
    "backfill": "node scripts/backfill_missing_summaries.mjs --max=10 --dry-run=false",
    "lint": "eslint \"{scripts,src}/**/*.{js,mjs}\"",
    "lint:fix": "eslint --fix \"{scripts,src}/**/*.{js,mjs}\"",
    "finish": "node scripts/finish_up.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "eslint": "^9.11.0"
  }
}
