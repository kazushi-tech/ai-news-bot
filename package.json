{
  "name": "ai-news-simple",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest:url": "node scripts/ingest.js",
    "daily": "node scripts/build_index_daily.mjs",
    "weekly": "node scripts/build_index_weekly.mjs",
    "home": "node scripts/build_home.mjs",
    "validate": "node scripts/validate_articles.mjs",
    "rebuild-all-daily": "node scripts/rebuild_all_daily.mjs",
    "source:today": "node scripts/build_source_news.mjs --today",
    "source:range": "node scripts/build_source_news.mjs",
    "one": "node scripts/ingest.js --url \"$URL\" && npm run daily && npm run weekly && npm run home && npm run validate && npm run source:today"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "jsdom": "^25.0.0",
    "yargs": "^17.7.2",
    "yaml": "^2.5.0",
    "undici": "^6.19.8"
  }
}
