# Google AI Studio / Generative Language API
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# 基本設定
TIMEZONE=Asia/Tokyo
NEWS_ROOT=./             # このリポのルートを指す（Vault直下に articles/, news/ を作る）
LINK_MODE=obsidian       # 固定（Publishは使わない）

# 追加の挙動
AI_NEWS_OFFLINE=0        # 1にするとAPI呼び出しをスキップ（整形テスト用）
