# Google AI Studio (Gemini) API Key
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash" # 既定：2.5-flash 固定


# 0: API使用 / 1: オフライン簡易要約（緊急時）
AI_NEWS_OFFLINE=0


# Obsidian Publish のサブパス（例：/dlab-ai-channel）。未使用なら空
PUBLISH_BASE=""

# Optional: パス設定（通常は自動検出されるため設定不要）
# NEWS_ROOT="/abs/path/to/ai-news-bot"

# Optional: Discord Queue Worker Settings
# MAX_ARTICLES_PER_DAY=5  # 1日の処理上限（0=無制限）

# Discord Inbox Approval Bot
# DISCORD_BOT_TOKEN=""  # Discord Bot Token
# DISCORD_CHANNEL_ID=""  # Target Channel ID
# DISCORD_ALLOWED_USER_IDS=""  # Comma-separated user IDs (empty = allow all)
# INBOX_POST_BATCH_SIZE=10  # Number of candidates to post at once