# === Paths & Index ===
NEWS_ROOT=./ai-news
HOME_LIMIT=12
FRESH_DAYS=10
# 正規表現。|区切りで除外（例: gpt-4|turbo）
IGNORE_PATTERNS=

# === Gemini ===
GOOGLE_API_KEY=YOUR_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# === Discord Watcher ===
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=   # 監視対象チャンネルID（空なら全チャンネルでURL拾う）

# === Git Auto Push ===
AUTO_PUSH=0