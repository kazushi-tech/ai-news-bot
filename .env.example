# --- Discord bot ---
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CHANNEL_ID=123456789012345678  # テキストチャンネルID

# --- GitHub (Discord/CLI→repository_dispatch 用) ---
GITHUB_OWNER=kazushi-tech
GITHUB_REPO=ai-news-bot
GITHUB_PAT=ghp_xxx                     # fine-grained。対象repo限定 / Actions:RW, Contents:RW 推奨

# --- Optional: ローカルで summarize.mjs を動かすときだけ ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- ローカルのログ用タイムゾーン ---
TZ=Asia/Tokyo
