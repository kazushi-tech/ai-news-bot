# Copy this file to ".env" and fill the values.

# --- Discord bot ---
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CHANNEL_ID=123456789012345678  # 文字列OK

# --- GitHub for repository_dispatch from the bot ---
GITHUB_OWNER=kazushi-tech
GITHUB_REPO=ai-news-bot
GITHUB_PAT=YOUR_GITHUB_PAT_WITH_repo_and_workflow

# --- Optional: run summarize.mjs locally (ActionsはSecretsを使うので不要) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Local timezone for logs etc. ---
TZ=Asia/Tokyo
